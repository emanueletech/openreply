# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional: send a bilingual campaign in one language only, chosen by the
# keyword that matched the comment. Write the message once with each half
# opened by its flag (🇮🇹 … 🇺🇸 …) and map keywords to languages here — an
# unmapped keyword leaves the message whole. Supported: it, en, es, fr, de, pt.
# KEYWORD_LANGUAGES=sfondi:it,wallpaper:en,wallpapers:en

# Optional: let a machine create campaigns without a browser session — the
# publishing automation does this before the reel exists. Calls authenticate
# with `Authorization: Bearer <AUTOMATION_API_TOKEN>` and act as the workspace
# owner. Leave the token unset and the door stays shut: session auth is then
# the only way in.
# AUTOMATION_API_TOKEN=generate-a-long-random-token
# Which workspace those calls write to. Set it explicitly: with more than one
# workspace the fallback picks the oldest OWNER membership, which is arbitrary.
# AUTOMATION_WORKSPACE_ID=your-workspace-id

# Optional: the publishing service the Pubblica page posts to, and its token.
# POSTER_URL=http://poster:8000
# POSTER_TOKEN=the-publishing-service-token

# The public address of this instance: it builds the tracked links that go out
# in the DMs, so it has to be a hostname your audience can actually resolve.
# NEXTAUTH_URL=https://link.example.com

# Optional: publish the instance through a Cloudflare Tunnel instead of opening
# a port on the router. Create the tunnel in Zero Trust, then paste its token
# here and point a public hostname at http://web:3000.
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
